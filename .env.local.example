# Local Postgres from `supabase start` (port 54322). No pooler locally, so both are equal.
# In production: DATABASE_URL = pooled (:6543, ?pgbouncer=true&connection_limit=1), DIRECT_URL = direct (:5432).
# NOTE: also copy these two into a `.env` file — the Prisma CLI reads `.env`, not `.env.local`.
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres
DIRECT_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres

# Auth.js — generate with: openssl rand -base64 32
AUTH_SECRET=replace-with-a-random-32-byte-secret

# Google OAuth client (Google Cloud Console → Credentials → OAuth client ID → Web application).
# Authorized redirect URI: http://localhost:3000/api/auth/callback/google
GOOGLE_CLIENT_ID=replace-with-google-client-id
GOOGLE_SECRET=replace-with-google-client-secret
