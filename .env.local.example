# Local Postgres in Docker (port 5432). Create a dedicated db + role first, e.g.:
#   psql -U <superuser>: CREATE ROLE workout_tracker LOGIN CREATEDB PASSWORD '<pw>';
#                        CREATE DATABASE workout_tracker_dev OWNER workout_tracker;
# No pooler locally, so DATABASE_URL and DIRECT_URL are the same.
# In production (Supabase-hosted): DATABASE_URL = pooled (:6543, ?pgbouncer=true&connection_limit=1), DIRECT_URL = direct (:5432).
# NOTE: also copy these two into a `.env` file — the Prisma CLI reads `.env`, not `.env.local`.
DATABASE_URL=postgresql://workout_tracker:<pw>@127.0.0.1:5432/workout_tracker_dev
DIRECT_URL=postgresql://workout_tracker:<pw>@127.0.0.1:5432/workout_tracker_dev

# Auth.js — generate with: openssl rand -base64 32
AUTH_SECRET=replace-with-a-random-32-byte-secret

# Google OAuth client (Google Cloud Console → Credentials → OAuth client ID → Web application).
# Authorized redirect URI: http://localhost:3000/api/auth/callback/google
GOOGLE_CLIENT_ID=replace-with-google-client-id
GOOGLE_SECRET=replace-with-google-client-secret
