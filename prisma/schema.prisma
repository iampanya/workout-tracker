// Typed client for the app's own (public-schema) tables. Non-model DB objects — the
// exercise_prs view, functions (import_backup/gen_referral_code/handle_new_user), triggers —
// are raw SQL inside prisma/migrations/*. Prisma is the client only; regenerate with
// `prisma db pull` against a public-only introspection.
//
// Data tables keep user_id as a plain scalar (no Prisma relation to the Auth.js `User` model).
// Per-user isolation is enforced in the service layer (every query filters by user_id), not RLS.
// The exercise_prs view is read via $queryRaw (see lib/dashboard/service.ts), so it is not
// modeled here.
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// Auth.js (NextAuth) models — the app's own auth store (replaces GoTrue). JWT sessions +
// Google-only OAuth mean no Session/VerificationToken tables are needed.
model User {
  id            String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name          String?
  email         String?   @unique
  emailVerified DateTime? @db.Timestamptz(6)
  image         String?
  accounts      Account[]

  @@map("users")
}

model Account {
  id                String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId            String  @db.Uuid
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model exercises {
  id                String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id           String?             @db.Uuid
  name              String
  muscle_group      String?
  is_preset         Boolean             @default(false)
  is_archived       Boolean             @default(false)
  created_at        DateTime            @default(now()) @db.Timestamptz(6)
  routine_exercises routine_exercises[]
  session_exercises session_exercises[]
  sets              sets[]

  @@unique([user_id, name], map: "exercises_user_name_key")
}

model profiles {
  id            String   @id @db.Uuid
  username      String   @unique
  created_at    DateTime @default(now()) @db.Timestamptz(6)
  referral_code String   @unique
  referred_by   String?  @db.Uuid
}

model routines {
  id                String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id           String              @db.Uuid
  name              String
  notes             String?
  created_at        DateTime            @default(now()) @db.Timestamptz(6)
  updated_at        DateTime            @default(now()) @db.Timestamptz(6)
  routine_exercises routine_exercises[]
  sessions          sessions[]
}

model routine_exercises {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  routine_id  String    @db.Uuid
  user_id     String    @db.Uuid
  exercise_id String    @db.Uuid
  position    Int
  target_sets Int?
  target_reps_min Int?
  target_reps_max Int?
  exercises   exercises @relation(fields: [exercise_id], references: [id], onUpdate: NoAction)
  routines    routines  @relation(fields: [routine_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([routine_id, position])
}

model sessions {
  id                String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id           String              @db.Uuid
  routine_id        String?             @db.Uuid
  name              String?
  session_date      DateTime            @db.Date
  started_at        DateTime            @default(now()) @db.Timestamptz(6)
  completed_at      DateTime?           @db.Timestamptz(6)
  notes             String?
  session_exercises session_exercises[]
  routines          routines?           @relation(fields: [routine_id], references: [id], onUpdate: NoAction)

  @@map("sessions")
}

model session_exercises {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  session_id  String    @db.Uuid
  user_id     String    @db.Uuid
  exercise_id String    @db.Uuid
  position    Int
  notes       String?
  exercises   exercises @relation(fields: [exercise_id], references: [id], onUpdate: NoAction)
  sessions    sessions  @relation(fields: [session_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  sets        sets[]

  @@unique([session_id, position])
}

model sets {
  id                  String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  session_exercise_id String            @db.Uuid
  user_id             String            @db.Uuid
  exercise_id         String            @db.Uuid
  set_number          Int
  weight_kg           Decimal           @db.Decimal(6, 2)
  reps                Int
  is_warmup           Boolean           @default(false)
  created_at          DateTime          @default(now()) @db.Timestamptz(6)
  exercises           exercises         @relation(fields: [exercise_id], references: [id], onUpdate: NoAction)
  session_exercises   session_exercises @relation(fields: [session_exercise_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([session_exercise_id, set_number])
  @@index([user_id, exercise_id, is_warmup], map: "sets_user_exercise_idx")
}

// Body-composition scans (see lib/body/schema.ts). Metric columns mirror SCAN_METRIC_KEYS;
// segments/report are validated JSON. One row per (user, measured_at): re-imports replace it.
model body_scans {
  id                   String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id              String   @db.Uuid
  measured_at          DateTime @db.Timestamptz(6)
  source               String   @default("arboleaf")
  weight_kg            Decimal  @db.Decimal(7, 2)
  bmi                  Decimal? @db.Decimal(7, 2)
  body_fat_pct         Decimal? @db.Decimal(7, 2)
  body_fat_kg          Decimal? @db.Decimal(7, 2)
  skeletal_muscle_kg   Decimal? @db.Decimal(7, 2)
  skeletal_muscle_pct  Decimal? @db.Decimal(7, 2)
  muscle_mass_pct      Decimal? @db.Decimal(7, 2)
  soft_lean_mass_kg    Decimal? @db.Decimal(7, 2)
  fat_free_mass_kg     Decimal? @db.Decimal(7, 2)
  body_water_l         Decimal? @db.Decimal(7, 2)
  body_water_pct       Decimal? @db.Decimal(7, 2)
  protein_kg           Decimal? @db.Decimal(7, 2)
  protein_pct          Decimal? @db.Decimal(7, 2)
  bone_mass_kg         Decimal? @db.Decimal(7, 2)
  bone_mass_pct        Decimal? @db.Decimal(7, 2)
  visceral_fat         Decimal? @db.Decimal(7, 2)
  subcutaneous_fat_pct Decimal? @db.Decimal(7, 2)
  subcutaneous_fat_kg  Decimal? @db.Decimal(7, 2)
  bmr_kcal             Decimal? @db.Decimal(7, 2)
  smi                  Decimal? @db.Decimal(7, 2)
  waist_hip_ratio      Decimal? @db.Decimal(7, 2)
  fitness_score        Decimal? @db.Decimal(7, 2)
  height_cm            Decimal? @db.Decimal(7, 2)
  age                  Decimal? @db.Decimal(7, 2)
  segments             Json?
  report               Json?
  created_at           DateTime @default(now()) @db.Timestamptz(6)

  @@unique([user_id, measured_at])
}

// Up to one goal per metric per user; start_value is the latest scan's value when the goal was
// first set (kept when only the target changes).
model body_goals {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id     String   @db.Uuid
  metric      String
  target      Decimal  @db.Decimal(7, 2)
  start_value Decimal  @db.Decimal(7, 2)
  created_at  DateTime @default(now()) @db.Timestamptz(6)

  @@unique([user_id, metric])
}
